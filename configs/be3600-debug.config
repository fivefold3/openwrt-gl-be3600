# Debug image for the GL.iNet Slate 7 (GL-BE3600): the stock image
# (be3600.config) plus ath12k debug messages (ath12k.debug_mask=) and
# ip-full/iperf3 for throughput tests.
# Do not ship images built from it.
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be3600=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y

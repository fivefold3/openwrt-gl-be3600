# Stock OpenWrt for the GL.iNet Slate 7 (GL-BE3600): the target's default
# packages, the device's hardware packages and LuCI, like an OpenWrt
# release image. Nothing else.
#   cp configs/be3600.config .config && make defconfig && make -j$(nproc)
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be3600=y
CONFIG_PACKAGE_luci=y

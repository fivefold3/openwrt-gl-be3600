# Extended image for the GL.iNet Slate 7 (GL-BE3600): the stock image
# (be3600.config) plus USB modem, tethering, USB storage and VPN support,
# a few tools, and the side-screen spinner. Dependencies are selected
# automatically by make defconfig.
#   cp configs/be3600-extra.config .config && make defconfig
#   make -j$(nproc) EXTRA_IMAGE_NAME=extra
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be3600=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# USB modems: QMI, MBIM, NCM and ECM/RNDIS network interfaces, the serial
# (AT) ports of Option/Quectel/Sierra/Qualcomm modems (usb_wwan comes with
# them), CDC-ACM and CDC-WDM, mode switching, and the LuCI protocols.
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_picocom=y

# Phone tethering (Android uses RNDIS/ECM/NCM above) and USB Ethernet adapters
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# USB storage and the usual filesystems, and Samba file sharing (kmod-usb3
# is also a target default, so the stock image has the host controller too)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_luci-app-samba4=y

# VPN: WireGuard and OpenVPN (OpenVPN is set up as an interface under
# Network > Interfaces; LuCI has no separate OpenVPN app any more)
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_openvpn-openssl=y

# Tools
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ethtool=y

# Side-screen spinner, installed and started at boot
CONFIG_PACKAGE_slate-spinner=y

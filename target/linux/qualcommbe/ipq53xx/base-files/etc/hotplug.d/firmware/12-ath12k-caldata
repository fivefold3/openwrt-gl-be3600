[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath12k/IPQ5332/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	gl.inet,gl-be3600)
		# 0x11800 is the region ftm.conf allocates to this radio on the
		# ap-mi04.1-c2 board (row "ap-mi04.1-c2,42,0,4096,71680,255"), ending
		# exactly where the QCN6432 block starts (0x12800). Region-sized rather
		# than block-sized (0xf800 on the tested unit) so a unit whose block
		# is larger is not truncated; the firmware honours the embedded length.
		caldata_extract "0:art" 0x1000 0x11800
		;;
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x1000 0x20000
		;;
	gl.inet,gl-be9300)
		caldata_extract_mmc "0:ART" 0x1000 0x20000
		;;
	esac
	;;
"ath12k/QCN6432/hw1.0/cal-ahb-soc@0:wifi-qcn6432.bin")
	case "$board" in
	gl.inet,gl-be3600)
		# QCN6432 (5 GHz) block: offset 0x12800 and region 0x1b800 straight from
		# ftm.conf ("ap-mi04.1-c2,0053,1,75776,112640,0"). Region-sized for the
		# same reason as above (the tested unit's block is 0x18800).
		caldata_extract "0:art" 0x12800 0x1b800
		;;
	esac
	;;
"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
	case "$board" in
	gl.inet,gl-be6500)
		caldata_extract "0:art" 0x58800 0x18800
		;;
	gl.inet,gl-be9300)
		# dualmac QCN9274: cal block is 0x27800 long (verified
		# against the ART partition dump from a live unit)
		caldata_extract_mmc "0:ART" 0x58800 0x27800
		;;
	esac
	;;
*)
	exit 1
	;;
esac

config slate-spinner 'main'
	option enabled '1'
	# Canvas rotation into the framebuffer: 0 for the kernel's native
	# landscape 284x76 fb0 (the board DTS sets rotate = <90> on the panel);
	# 90 or 270 only if fb0 is the portrait 76x284 kind.
	option rotation '0'
	# backlight level 0-11 (pwm-backlight brightness-levels)
	option brightness '8'
	# touch demo: random characters trail the finger and fade out
	option touch '1'

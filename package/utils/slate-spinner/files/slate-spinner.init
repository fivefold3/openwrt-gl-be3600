#!/bin/sh /etc/rc.common
# "Working" spinner animation on the GL.iNet Slate 7 side screen.
# Config: /etc/config/slate-spinner (rotation: 0 for the native 284x76 fb,
# 90/270 for a portrait 76x284 one; brightness 0-11; touch enables the
# character trail under the finger).
#
# Runs last (START=99). The panel, backlight and touch drivers are built into
# the kernel; the program itself waits for /dev/fb0 if it is still probing.

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/slate-spinner

unbind_fbcon() {
	# no-op unless a kernel with the VT console is in use: fbcon would grab
	# fb0 and paint its cursor over the animation
	local v
	for v in /sys/class/vtconsole/vtcon*; do
		[ -f "$v/name" ] || continue
		grep -q "frame buffer" "$v/name" 2>/dev/null && echo 0 > "$v/bind"
	done
}

start_service() {
	local enabled rotation brightness touch

	config_load slate-spinner
	config_get_bool enabled main enabled 1
	config_get rotation main rotation 0
	config_get brightness main brightness 8
	config_get_bool touch main touch 1

	[ "$enabled" = 1 ] || return 0

	unbind_fbcon

	procd_open_instance
	procd_set_param command "$PROG" -r "$rotation" -b "$brightness"
	[ "$touch" = 1 ] || procd_append_param command -T
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger slate-spinner
}

reload_service() {
	stop
	start
}
